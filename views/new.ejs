<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
</head>
<body>
    <h2>Add New Chat</h2>
    <form action="/chats" method="POST">
        <input type="text" name="from" placeholder="Your name"><br> <br>
        <textarea name="message" id="">Write your message here</textarea> <br> <br>
        <input type="text" name="to" placeholder="Name of reciver"> <br> <br>
        <button>Create Chat</button>
    </form>
</body>
</html>